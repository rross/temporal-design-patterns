{
  "name": "Eager Workflow Start",
  "languages": {
    "go": {
      "label": "Go",
      "files": ["main.go", "workflows.go", "activities.go", "shared.go"],
      "worker": "echo 'Worker starts inside main.go alongside the starter'",
      "starter": "go run main.go workflows.go activities.go shared.go",
      "workerProcessPattern": "go run main.go",
      "diskGib": 2
    },
    "java": {
      "label": "Java",
      "files": [
        "src/main/java/Main.java",
        "src/main/java/TransactionWorkflow.java",
        "src/main/java/Activities.java",
        "src/main/java/Shared.java"
      ],
      "worker": "echo 'Worker starts inside Main.java alongside the starter'",
      "starter": "mvn -q -B compile exec:java -Dexec.mainClass=Main",
      "workerProcessPattern": "exec.mainClass=Main",
      "diskGib": 3,
      "memoryGib": 3
    },
    "python": {
      "label": "Python",
      "files": ["main.py", "workflows.py", "activities.py", "shared.py"],
      "worker": "echo 'Worker starts inside main.py alongside the starter'",
      "starter": "uv run python main.py",
      "workerProcessPattern": "python main.py",
      "diskGib": 1
    }
  }
}
